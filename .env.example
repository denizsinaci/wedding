# --- Public (embedded into the static bundle) -------------------------------

# Repo path "owner/repo" — used by the form to know where to POST issues.
# In CI this is set automatically from ${{ github.repository }}.
NEXT_PUBLIC_GH_REPO=

# Fine-grained Personal Access Token. Required for the form to actually
# submit. Setup:
#   1. github.com → Settings → Developer settings → Personal access tokens
#      → Fine-grained tokens → Generate new token.
#   2. Resource owner: your account. Repository access: "Only select repositories"
#      → pick this repo only.
#   3. Permissions → Repository → Issues: Read and write. Nothing else.
#   4. Set an expiration past your wedding date.
#   5. Copy the token, paste it here for local dev AND add it to the repo's
#      Actions secrets as NEXT_PUBLIC_GH_TOKEN.
#
# NOTE: This token ships in the static JS bundle. Its only privilege is
# "create issues in this one repo". Worst case if leaked: spam issues, which
# the workflow validates + auto-closes.
NEXT_PUBLIC_GH_TOKEN=

# Passcode for the /katilimcilar admin view. Embedded in the static bundle —
# friction, not security.
NEXT_PUBLIC_ADMIN_PASSCODE=

# Set automatically by the GitHub Pages workflow. Leave blank locally.
NEXT_PUBLIC_BASE_PATH=
